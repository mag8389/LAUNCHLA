{
  "name": "innova-dash-online",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "dash.YOUR-DOMAIN.example", "custom_domain": true }],
  "vars": {
    "ACCESS_ISSUER": "https://YOUR-TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "innova-dash-online",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
